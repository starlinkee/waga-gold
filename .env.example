# Skopiuj do .env.local i uzupełnij. Nie commituj prawdziwych kluczy.
# Stripe (pakiet 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public site URL / publiczny adres strony
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend (e-mail, pakiet 3)
RESEND_API_KEY=
# Sender address verified in Resend / nadawca zweryfikowany w Resend
RESEND_FROM=
# Owner notification address / adres właściciela
OWNER_EMAIL=
# 1 = mock Stripe (lokalnie, bez prawdziwych płatności). NIGDY na produkcji (ignorowane gdy VERCEL_ENV=production)
STRIPE_MOCK=1
